{
  "name": "@pigorv/claude-monitor",
  "version": "0.6.0",
  "description": "Local observability dashboard for Claude Code sessions — context pressure, thinking inspection, sub-agent debugging",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pigorv/claude-monitor.git"
  },
  "homepage": "https://github.com/pigorv/claude-monitor#readme",
  "bugs": {
    "url": "https://github.com/pigorv/claude-monitor/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "observability",
    "dashboard",
    "context-window",
    "token-tracking",
    "agent",
    "llm",
    "anthropic"
  ],
  "bin": {
    "claude-monitor": "./dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && vite build",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "dev:server": "node --watch dist/index.js start --no-open",
    "dev:frontend": "vite dev",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:schema-drift": "SCHEMA_DRIFT_STRICT=1 vitest run test/fixtures/schema-drift-canary.test.ts",
    "coverage": "vitest run --coverage",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:screenshots": "node scripts/demo-screenshots.mjs",
    "demo:walkthrough": "node scripts/demo-walkthrough.mjs",
    "demo:walkthrough-full": "node scripts/demo-walkthrough-full.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.7.0",
    "open": "^10.1.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/prismjs": "^1.26.6",
    "@vitest/coverage-v8": "^4.1.9",
    "htm": "^3.1.1",
    "playwright": "^1.58.2",
    "preact": "^10.25.0",
    "preact-render-to-string": "^6.6.6",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "uplot": "^1.6.31",
    "vite": "^6.0.0",
    "vitest": "^4.1.1"
  }
}
