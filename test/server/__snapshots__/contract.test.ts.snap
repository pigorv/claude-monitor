// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`API contract: clear (destructive) > POST /api/clear?confirm=true (200) 1`] = `
{
  "cleared": "boolean",
  "message": "string",
}
`;

exports[`API contract: empty DB > GET /api/sessions (empty) 1`] = `
{
  "limit": "number",
  "offset": "number",
  "sessions": [],
  "total": "number",
}
`;

exports[`API contract: empty DB > GET /api/stats (empty) 1`] = `
{
  "avg_duration_ms": "number",
